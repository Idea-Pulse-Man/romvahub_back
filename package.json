{
  "name": "remote-ops-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./node_modules/prisma/build/index.js generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node scripts/migrate-deploy.mjs",
    "prisma:studio": "node ./node_modules/prisma/build/index.js studio",
    "db:seed": "tsx prisma/seed.ts",
    "admin": "tsx scripts/create-admin.ts",
    "super-admin": "tsx scripts/super-admin.ts",
    "proofs:fingerprint": "tsx scripts/fingerprint-proofs.ts",
    "files:to-db": "tsx scripts/move-files-to-db.ts",
    "resumes:to-json": "tsx scripts/resumes-to-json.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@google/genai": "^2.19.0",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sparticuz/chromium": "^149.0.0",
    "@vercel/functions": "^3",
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.1",
    "domhandler": "^6.0.1",
    "dotenv": "^17.4.2",
    "express": "^5",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "multer": "^2.3.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-core": "^25.9.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/carlito": "^5.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
