# Copy to .env and fill in. .env is gitignored; only this example is committed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Matches the throwaway container in README §5.2. Point it at any Postgres 14+.
DATABASE_URL=postgresql://globaleyes:globaleyes@localhost:55432/global_eyes

# Only needed when DATABASE_URL points at a transaction-mode pooler, which
# `prisma migrate deploy` cannot use. Leave unset locally.
# DIRECT_URL=

# A separate database for `yarn test` — the suite TRUNCATEs between tests, so it
# must never point at a database holding real data.
TEST_DATABASE_URL=postgresql://globaleyes:globaleyes@localhost:55432/global_eyes_test

# --- Auth -------------------------------------------------------------------
# Two DIFFERENT secrets, >=32 chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars

# Access tokens are short-lived; refresh tokens rotate on every use.
# Each rotation issues a fresh REFRESH_TOKEN_TTL_DAYS, so a session ends only
# after that long with no activity, and the user must then sign in again.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=1

# --- HTTP -------------------------------------------------------------------
# Comma-separated. The frontend's Vite dev server defaults to 5173.
CORS_ORIGIN=http://localhost:5173

# Leave unset for localhost. Set in production when the API and the app are on
# sibling subdomains, e.g. ".example.com".
# COOKIE_DOMAIN=

# lax (default) is correct when the app reaches the API on its own origin --
# the frontend's recommended setup, where a rewrite proxies /api here. Use
# `none` only when the app calls this API on a different origin directly; it
# requires NODE_ENV=production (browsers drop a SameSite=None cookie that is
# not Secure) and leaves CSRF for the deployment to handle. See README section 7.
# COOKIE_SAMESITE=lax

# --- Job URL parsing --------------------------------------------------------
# Where POST /api/jobs/parse turns when fetching the job page itself yields no
# posting (a board that answers 403 to non-browsers, or a page that is empty
# until JavaScript runs). The page URL is appended to this prefix; the answer
# is read as Markdown. Default: Jina's public reader. Set empty to disable.
# JOB_READER_URL=https://r.jina.ai/

# Jina serves anonymous calls from a quiet network but refuses them from a
# busy one (a cloud provider's, usually), so a deployment wants a key -- free
# at https://jina.ai/reader. Sent as a bearer token.
# JOB_READER_API_KEY=

# Development only: let the parser fetch a URL whose host resolves to a private
# address. For a machine behind a VPN or a filtering resolver that answers every
# name with a local proxy address, where the SSRF check would otherwise refuse
# every job URL. Ignored (with a warning) under NODE_ENV=production.
# JOB_FETCH_ALLOW_PRIVATE_ADDRESSES=false

# --- AI (Resume generation) -------------------------------------------------
# Which platform writes the Resume behind POST /api/resume/generate. An admin
# screen will eventually choose this and store the key with it; for now both
# come from here. Default: openai.
AI_PROVIDER=openai

# Only the key for the selected AI_PROVIDER is read; the others can stay unset.
# Leave all of them unset and every other route still works -- Resume generation
# alone answers 503, naming the variable it wanted.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Overrides that provider's default model (gpt-5 / claude-opus-5 /
# gemini-2.5-pro / deepseek-chat). Set it to pin a version or to run something cheaper. An admin
# can also pick the model in the app, which takes precedence over this.
# AI_MODEL=

# How long one generation may take before the API gives up and answers 504.
# Default 110000. This MUST stay below the serverless function's own budget --
# `maxDuration` in vercel.json, 120s -- or the runtime kills the whole
# invocation first and returns an opaque "Task timed out" with no usable error.
# Raise both together, never just this one. See README section 6.4.
# AI_REQUEST_TIMEOUT_MS=110000

# Printing the Resume to PDF needs a Chromium build. Unset, the bundled
# @sparticuz/chromium is used, which is what a serverless deployment wants. Set
# it in development to reuse a browser you already have and skip the unpack:
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_EXECUTABLE_PATH=

# --- Object storage (candidate photos) --------------------------------------
# Any S3-compatible bucket: Tigris, Cloudflare R2, MinIO or AWS itself. The
# endpoint is what selects between them; requests are made path-style so the
# non-AWS ones work unchanged. All five work together -- leave them unset and
# photo upload is simply off, with POST /api/profile/photo answering 503 and
# every other route unaffected.
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# The bucket photos are written to. Keep it private: the API hands out
# short-lived signed URLs rather than public links.
# AWS_S3_BUCKET=remote-ops-photos

# How long a signed photo URL stays valid, in seconds. Default 3600 (one hour).
# S3_SIGNED_URL_TTL_SECONDS=3600

# --- Config encryption ------------------------------------------------------
# Encrypts the few secrets stored in the database -- today only the AI API key
# an admin saves from the app (README section 6.11). Optional: left unset, the
# key is derived from JWT_ACCESS_SECRET, which means rotating that secret makes
# a stored API key undecryptable. Set this to decouple the two:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CONFIG_ENCRYPTION_KEY=

# "Make" in the Applications table (ChatGPT in a local Chrome window, no API key).
# true: this computer makes the Resume + cover letter automatically for Draft applications
# without one (also those added through romva.space), while Start is on in the Applications page.
# Optional: CHATGPT_AUTO_MAKE_POLL_MS (15000), CHATGPT_AUTO_MAKE_DAYS (7, how far back to look).
CHATGPT_AUTO_MAKE=false
# Where the API saves the files itself: <dir>\<Profile_Name>\<Company_Role>\
# Empty: the browser page that clicked Make saves them into its chosen folder.
RESUME_SAVE_DIR=
# Optional: CHATGPT_PROMPT_FILE, CHATGPT_COVER_LETTER_PROMPT_FILE, CHATGPT_TEMPORARY_CHAT, CHATGPT_TIMEOUT_MS
# New jobs at companies with more employees than this (from the scraper's "Size:" note) are filed as Skip. Default 5000.
SKIP_COMPANY_SIZE_OVER=5000
